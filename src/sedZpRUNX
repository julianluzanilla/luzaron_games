import './style.css'
import { GAMES, type GameId } from './shell/game-nav'
import { mountQueensApp, unmountQueensApp } from './queens-app'
import { mountWordleApp, unmountWordleApp } from './wordle-app'

const LAST_GAME_KEY = 'luzaron-last-game-v1'

interface GameModule {
  mount: () => void
  unmount: () => void
}

const MODULES: Partial<Record<GameId, GameModule>> = {
  queens: { mount: mountQueensApp, unmount: unmountQueensApp },
  sudoku: { mount: mountSudokuApp, unmount: unmountSudokuApp },
  wordle: { mount: mountWordleApp, unmount: unmountWordleApp },
}

let currentGame: GameId | null = null

function isPlayable(value: string | null): value is GameId {
  if (!value) return false

  return GAMES.some((game) => game.id === value && game.available) && value in MODULES
}

function readInitialGame(): GameId {
  const fromHash = window.location.hash.replace('#/', '').replace('#', '')
  if (isPlayable(fromHash)) return fromHash

  const stored = window.localStorage.getItem(LAST_GAME_KEY)
  if (isPlayable(stored)) return stored

  return 'queens'
}

function showGame(game: GameId): void {
  if (game === currentGame) return

  if (currentGame) MODULES[currentGame]?.unmount()

  currentGame = game

  try {
    window.localStorage.setItem(LAST_GAME_KEY, game)
  } catch {
    // Sin almacenamiento: solo se pierde el juego recordado.
  }

  if (window.location.hash !== `#/${game}`) {
    window.history.replaceState(null, '', `#/${game}`)
  }

  MODULES[game]?.mount()
}

document.addEventListener('click', (event) => {
  const target = event.target as HTMLElement | null
  const button = target?.closest<HTMLButtonElement>('[data-action="select-game"]')

  if (!button || button.disabled) return

  const game = button.dataset.game ?? ''

  if (isPlayable(game)) showGame(game)
})

window.addEventListener('hashchange', () => {
  const fromHash = window.location.hash.replace('#/', '').replace('#', '')
  if (isPlayable(fromHash)) showGame(fromHash)
})

showGame(readInitialGame())
